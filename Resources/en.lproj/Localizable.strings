"À télécharger" = "To download";


/* Mise a jour d'un jeu avant de le lancer */
"Mettre à jour et jouer" = "Update and Play";
"Jouer sans mettre à jour" = "Play Without Updating";
"Mettre à jour sans jouer" = "Update Without Playing";
"Build installé : %@ · publié : %@" = "Installed build: %1$@ · published: %2$@";
"Lance la version installée. La mise à jour sera proposée à nouveau au prochain lancement." = "Launches the installed version. The update will be offered again at the next launch.";
